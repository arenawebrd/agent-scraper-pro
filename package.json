{
  "name": "agent-scraper-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de Telegram que busca prospectos en Google Maps (mismo motor que Prospect Hub) y exporta CSV/JSON.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "scrape": "tsx scripts/scrape.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "dotenv": "^17.2.3",
    "grammy": "^1.39.0",
    "serpapi": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.14.0",
    "eslint": "^9.39.5",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.2"
  }
}
