# ── Obligatorio ─────────────────────────────────────────────
# Token de tu bot de Telegram (lo da @BotFather)
TELEGRAM_BOT_TOKEN=

# ── Scraper (Google Maps) ───────────────────────────────────
# Fuente de datos: auto (elige la más barata) | anyapi | serpapi | mock
#   auto   → AnyAPI si hay ANYAPI_KEY, si no SerpAPI, si no MOCK
#   anyapi → getanyapi.com (~$0.0013 por página de 20 resultados) · SIN horarios
#   serpapi→ serpapi.com (1 crédito por página) · CON horarios y extensions
#   mock   → datos de prueba, gratis
# Cambia en caliente desde el bot con /proveedor
MAPS_PROVIDER=auto

# AnyAPI — https://getanyapi.com (página de 20 resultados ≈ $0.0013)
# Geocodifica con Nominatim (gratis). Sin ella el bot usa SerpAPI o MOCK.
# Nota: maps.search_nearby no devuelve horarios; si los necesitas → serpapi.
ANYAPI_KEY=

# SerpAPI — https://serpapi.com (1 crédito por página = 20 resultados)
# Si no hay ninguna key el bot funciona en MODO MOCK (datos de prueba, sin coste)
SERPAPI_KEY=

# Opcional: rellena localidad, provincia y código postal cuando el proveedor no los trae
# (reverse geocoding de Mapbox, 1 petición por negocio, gratis hasta 100k/mes)
MAPBOX_TOKEN=

# Detalle de cada negocio (web/teléfono que faltan, check-in de hoteles) vía type=place
# COSTE: 1 crédito EXTRA de SerpAPI por negocio → apagado por defecto para no quemar la cuota
# Solo aplica a SerpAPI (AnyAPI no cobra detalle)
ENRICH_DETAILS=false

# ── Ajustes del bot ─────────────────────────────────────────
# Resultados por búsqueda: un número (tope 200) o 0 = TODOS los disponibles
# Cada página son 20 resultados (SerpAPI 1 crédito / AnyAPI ≈ $0.0013)
MAX_RESULTS=0
# País por defecto (código ISO, ej: do, es, mx, ar)
DEFAULT_GL=do
# Idioma por defecto (ej: es, en)
DEFAULT_HL=es

# ── Seguridad ───────────────────────────────────────────────
# IDs de chat de Telegram autorizados, separados por coma (ej: 123456789,987654321)
# Obtén el tuyo hablándole a @userinfobot. Si está vacío el bot queda ABIERTO a cualquiera.
ALLOWED_CHAT_IDS=

# ── Agente IA (lenguaje natural) ────────────────────────────
# gemini | openai | claude | openrouter | groq | opencode | none
AI_PROVIDER=opencode
# Modelo (opcional; si no se pone se usa el default del proveedor)
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENCODE_API_KEY=
