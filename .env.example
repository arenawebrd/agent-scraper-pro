# ── Obligatorio ─────────────────────────────────────────────
# Token de tu bot de Telegram (lo da @BotFather)
TELEGRAM_BOT_TOKEN=

# ── Scraper (Google Maps vía SerpAPI) ───────────────────────
# Si está vacío el bot funciona en MODO MOCK (datos de prueba, sin coste)
SERPAPI_KEY=

# Opcional: enriquece dirección (calle/ciudad/provincia) de cada lead
MAPBOX_TOKEN=

# Detalle de cada negocio (web/teléfono que faltan, check-in de hoteles) vía type=place
# COSTE: 1 crédito EXTRA de SerpAPI por negocio → apagado por defecto para no quemar la cuota
ENRICH_DETAILS=false

# ── Seguridad ───────────────────────────────────────────────
# IDs de chat de Telegram autorizados, separados por coma (ej: 123456789,987654321)
# Obtén el tuyo hablándole a @userinfobot. Si está vacío el bot queda ABIERTO a cualquiera.
ALLOWED_CHAT_IDS=

# ── Agente IA (lenguaje natural) ────────────────────────────
# gemini | openai | claude | openrouter | groq | opencode | none
AI_PROVIDER=opencode
# Modelo (opcional; si no se pone se usa el default del proveedor)
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENCODE_API_KEY=

# ── Ajustes del bot ─────────────────────────────────────────
# Resultados por búsqueda: un número (tope 200) o 0 = TODOS los disponibles
# Cada página de SerpAPI son 20 resultados y 1 crédito; sin límite Google suele dar ~60-120
MAX_RESULTS=0
# País por defecto (código ISO, ej: do, es, mx, ar)
DEFAULT_GL=do
# Idioma por defecto (ej: es, en)
DEFAULT_HL=es
